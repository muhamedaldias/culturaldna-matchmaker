# ---------------------------------------------------------------------------
# Qloo — server-only. Never expose this key to the browser.
# Get a hackathon key at https://hackathon.qloo.com — requests must target
# https://hackathon.api.qloo.com and authenticate with the X-Api-Key header.
# Leave QLOO_API_KEY empty to run the clearly-labelled curated demo.
# ---------------------------------------------------------------------------
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---------------------------------------------------------------------------
# Google Gemini — server-only. Used for the blind take, probe planning,
# strategy memo and red-team pass. Without it, live mode returns the
# deterministic report only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public canonical URL (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
